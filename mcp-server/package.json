{
  "name": "mindustry-agent-mcp",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "MCP tool interface for the Mindustry Agent co-op assistant",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "harness": "tsx harness/smoke.ts",
    "scenario": "tsx harness/scenario.ts",
    "llm-harness": "tsx harness/llm.ts",
    "writer-harness": "tsx harness/writer.ts",
    "allowlist-harness": "tsx harness/allowlist.ts",
    "rate-limit-harness": "tsx harness/rate-limit.ts",
    "mcp-http-smoke": "tsx harness/mcp-http-smoke.ts",
    "host-smoke": "tsx harness/host-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
